<?php
// user/dashboard.php — Senior-friendly dashboard
require_once '../includes/config.php';
require_once '../includes/db_connection.php';
require_once '../includes/security.php';
require_once '../includes/auth.php';
require_once '../includes/user_functions.php';
require_once '../includes/benefit_rules.php';

$auth->requireLogin();
$current_user = $auth->getCurrentUser();
$db = Database::getInstance();

// ---------- Find member ----------
$member = getUserMemberData($db, $current_user);

if (!$member && !empty($current_user['user_id'])) {
    $member = $db->getSingle(
        "SELECT * FROM members WHERE user_id = ?",
        [$current_user['user_id']], 'i'
    );
}
if (!$member && !empty($current_user['username'])) {
    $member = $db->getSingle(
        "SELECT * FROM members WHERE username = ?",
        [$current_user['username']], 's'
    );
}
if (!$member || empty($member['member_code'])) {
    header('Location: ../logout.php?error=member_not_found');
    exit();
}

$member_code = $member['member_code'];
$user_id     = $current_user['user_id'];

// ---------- Rules-based benefit computation ----------
$summary = BenefitRules::getMemberBenefitSummary($db, $member_code);

$years_as_member   = $summary['years_as_member']    ?? 0;
$months_as_member  = $summary['months_as_member']   ?? 0;
$missed_payments   = $summary['missed_payments']    ?? 0;
$expected_payments = $summary['expected_payments']  ?? 0;
$paid_payments     = $summary['paid_payments']      ?? 0;
$is_good_payer     = $summary['is_good_payer']      ?? false;
$good_payer_bonus  = $summary['good_payer_bonus']   ?? 0;
$base_benefit      = $summary['base_benefit']       ?? 0;
$deduction         = $summary['deduction']          ?? 0;
$deduction_reason  = $summary['deduction_reason']   ?? '';
$total_benefit     = $summary['total_benefit']      ?? 0;
$accident_bonus    = $summary['accident_bonus']     ?? 10000;
$accident_max      = $summary['accident_max_benefit'] ?? 0;
$probation         = $summary['probation']          ?? ['months'=>0,'label'=>'No probation','class'=>'success'];
$is_donation       = $summary['is_donation']        ?? false;

// ---------- Financial ----------
$balance              = getUserBalance($db, $member_code);
$monthly_contribution = (float)($member['monthly_contribution'] ?? 100);
$expected_total       = $months_as_member * $monthly_contribution;
$total_paid           = (float)($balance['total_paid'] ?? 0);
$current_balance      = $expected_total - $total_paid;
$progress_pct         = $expected_total > 0
    ? min(100, round(($total_paid / $expected_total) * 100))
    : 0;

// ---------- Next due ----------
$last_payment = $db->getSingle(
    "SELECT MAX(payment_date) AS last_date FROM payments 
     WHERE member_id = ? AND payment_status = 'confirmed'",
    [$member_code], 's'
);
$last_payment_date = $last_payment['last_date'] ?? $member['date_joined'] ?? date('Y-m-d');
$next_due_date     = date('Y-m-d', strtotime($last_payment_date . ' +1 month'));

$today          = new DateTime();
$next_due_obj   = new DateTime($next_due_date);
$days_until_due = (int)$today->diff($next_due_obj)->format('%r%a');
$is_overdue     = $days_until_due < 0;
$is_due_soon    = $days_until_due >= 0 && $days_until_due <= 7;

// ---------- Tenure text ----------
$joined_dt = new DateTime($member['date_joined'] ?? 'now');
$diff      = $joined_dt->diff(new DateTime());
$tenure_text = '';
if ($diff->y > 0) $tenure_text .= $diff->y . ' year' . ($diff->y > 1 ? 's' : '');
if ($diff->m > 0) $tenure_text .= ($tenure_text ? ', ' : '') . $diff->m . ' month' . ($diff->m > 1 ? 's' : '');
if (!$tenure_text) $tenure_text = 'New member';

$initials = strtoupper(
    substr($member['first_name'] ?? 'U', 0, 1) .
    substr($member['last_name']  ?? '', 0, 1)
);

$is_admin   = ($current_user['role'] === 'admin');
$csrf_token = Security::generateCSRFToken();
?>
