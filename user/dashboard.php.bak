}

/* ============================================================
   BREAKDOWN — improved alignment
============================================================ */
.breakdown {
    border-top: 1px solid rgba(255,255,255,0.1);
    padding: 0.5rem 1.25rem 0.9rem;
    background: rgba(0,0,0,0.14);
}

.breakdown-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 0.6rem 0;
    font-size: 0.95rem;
    border-bottom: 1px dashed rgba(255,255,255,0.1);
}

.breakdown-row:last-child { border-bottom: none; }

.breakdown-row .label {
    display: flex;
    align-items: center;
    gap: 10px;
    color: rgba(255,255,255,0.9);
    flex: 1;
    min-width: 0;
}

.breakdown-row .label i {
    font-size: 0.95rem;
    width: 18px;
    text-align: center;
    color: rgba(255,255,255,0.65);
    flex-shrink: 0;
}

.breakdown-row .label .label-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.25;
}

.breakdown-row .label .label-main {
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.breakdown-row .label .label-sub {
    font-size: 0.78rem;
    color: rgba(255,255,255,0.55);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.breakdown-row .amt {
    font-weight: 800;
    white-space: nowrap;
    color: #fff;
    font-size: 1rem;
    flex-shrink: 0;
    text-align: right;
}

.breakdown-row .amt.pos { color: #86e29e; }
.breakdown-row .amt.neg { color: #ff9c95; }
.breakdown-row .amt.dim { color: rgba(255,255,255,0.4); }

.breakdown-total {
    margin-top: 0.4rem;
    padding-top: 0.75rem;
    border-top: 2px solid rgba(251,191,36,0.4);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
}

.breakdown-total .lbl {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 800;
    color: rgba(255,255,255,0.85);
}

.breakdown-total .val {
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--yellow-accent);
    letter-spacing: -0.02em;
}

.breakdown-note {
    margin-top: 0.6rem;
    padding-top: 0.6rem;
    border-top: 1px dashed rgba(255,255,255,0.1);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.9rem;
    color: rgba(255,255,255,0.75);
    flex-wrap: wrap;
    gap: 8px;
}

.breakdown-note .v { color: #86e29e; font-weight: 800; }

/* Alert pills */
.pill {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 0.8rem 1rem;
    border-radius: var(--radius);
    font-size: 0.95rem;
    margin-top: 0.6rem;
    line-height: 1.5;
    border: 2px solid;
    font-weight: 500;
}

.pill i { font-size: 1.15rem; margin-top: 2px; flex-shrink: 0; }
.pill strong { font-weight: 800; }

.pill.success { background: rgba(22,163,74,0.18); border-color: rgba(134,226,158,0.4); color: #b7e8c4; }
.pill.warning { background: rgba(217,119,6,0.18); border-color: rgba(251,191,36,0.4); color: #fad98a; }
.pill.danger  { background: rgba(220,38,38,0.18); border-color: rgba(255,156,149,0.4); color: #ffb3ad; }

/* ============================================================
   MEMBERSHIP AT A GLANCE — compact 2×2
============================================================ */
.glance-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
}

.glance-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.85rem 1rem;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: var(--shadow-xs);
    transition: all 0.18s ease;
    min-width: 0;
}

.glance-card:hover {
    border-color: var(--brand-500);
    box-shadow: var(--shadow-sm);
}

.glance-card .ic {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    flex-shrink: 0;
    background: var(--brand-100);
    color: var(--brand-700);
}

.glance-card .ic.green { background: var(--success-100); color: var(--success-700); }
.glance-card .ic.gold  { background: var(--yellow-100);  color: var(--yellow-dark); }
.glance-card .ic.red   { background: var(--danger-100);  color: var(--danger-700); }
.glance-card .ic.gray  { background: #eef1f6;            color: var(--ink-500); }

.glance-card .body {
    min-width: 0;
    flex: 1;
}

.glance-card .val {
    font-size: 1.2rem;
    font-weight: 900;
    color: var(--ink-900);
    line-height: 1.15;
    letter-spacing: -0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.glance-card .val small {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink-500);
    letter-spacing: 0;
}

.glance-card .lbl {
    font-size: 0.82rem;
    color: var(--ink-500);
    font-weight: 600;
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ============================================================
   OVERDUE CTA
============================================================ */
.overdue-cta {
    background: linear-gradient(135deg, #7f1d1d 0%, #a01a1a 100%);
    color: #fff;
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
    box-shadow: 0 8px 22px rgba(160,26,26,0.2);
}

.overdue-cta .txt h3 {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0 0 6px 0;
    display: flex;
    align-items: center;
    gap: 12px;
    color: #fff;
}

.overdue-cta .txt p {
    margin: 0;
    font-size: 1rem;
    color: rgba(255,255,255,0.9);
    line-height: 1.5;
}

.btn-pay {
    background: #fff;
    color: var(--danger-700);
    padding: 1rem 1.75rem;
    border-radius: var(--radius);
    font-weight: 800;
    font-size: 1.05rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    transition: all 0.18s;
    box-shadow: 0 3px 10px rgba(0,0,0,0.15);
    white-space: nowrap;
    border: none;
}

.btn-pay:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.22);
    color: var(--danger-700);
}

.btn-pay i { font-size: 1.25rem; }

/* ============================================================
   RESPONSIVE
============================================================ */
.mobile-menu-toggle {
    display: none;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--ink-700);
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    font-size: 1.25rem;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s;
}

.mobile-menu-toggle:hover { background: var(--paper); border-color: var(--brand-500); color: var(--brand-600); }

.sidebar-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15,41,66,0.5);
    z-index: 1040;
    backdrop-filter: blur(2px);
}
.sidebar-backdrop.show { display: block; }

@media (max-width: 992px) {
    #sidebar-wrapper {
        position: fixed;
        top: 0; left: 0;
        z-index: 1050;
        width: 280px !important;
        transform: translateX(-100%);
        transition: transform 0.25s ease;
        box-shadow: 8px 0 24px rgba(0,0,0,0.2);
    }
    #sidebar-wrapper.mobile-open { transform: translateX(0); }

    #sidebar-wrapper .brand-name,
    #sidebar-wrapper .brand-sub,
    #sidebar-wrapper .list-group-item span,
    #sidebar-wrapper .nav-section-label { display: inline; }

    #sidebar-wrapper .list-group-item { justify-content: flex-start; padding: 0.95rem 1rem; }
    #sidebar-wrapper .list-group-item i { margin: 0; }
    #sidebar-wrapper.collapsed { width: 280px !important; }

    .mobile-menu-toggle { display: inline-flex; }

    .main { padding: 1.35rem; }
    .balance-panel .bp-amount { font-size: 2rem; }
    .benefit-panel .bp-amount .num { font-size: 2rem; }
    .topbar { padding: 1rem 1.35rem; }
}

@media (max-width: 576px) {
    html { font-size: 16px; }
    .topbar { padding: 0.85rem 1rem; }
    .topbar-date { display: none; }
    .user-chip .meta { display: none; }
    .user-chip { padding: 4px; }

    .main { padding: 1rem; }
    .section-title { flex-direction: column; align-items: flex-start; gap: 6px; }
    .balance-panel { padding: 1.1rem 1.2rem; }
    .balance-panel .bp-amount { font-size: 1.85rem; }
    .benefit-panel .bp-amount .num { font-size: 1.85rem; }
    .benefit-panel .bp-amount,
    .benefit-panel .bp-head,
    .breakdown { padding-left: 1rem; padding-right: 1rem; }
    .overdue-cta { padding: 1.35rem; }

    /* Quick pay button — mobile tuning */
    .quick-pay {
        padding: 7px 12px;
        font-size: 0.8rem;
        gap: 6px;
    }
    .quick-pay .qp-icon {
        width: 18px;
        height: 18px;
        font-size: 0.65rem;
    }

    /* Breakdown — mobile tuning */
    .breakdown-row {
        gap: 10px;
        padding: 0.55rem 0;
    }
    .breakdown-row .label .label-main {
        font-size: 0.9rem;
    }
    .breakdown-row .label .label-sub {
        font-size: 0.72rem;
    }
    .breakdown-row .amt {
        font-size: 0.95rem;
    }
    .breakdown-total .val {
        font-size: 1.2rem;
    }

    /* Membership at a glance — mobile tuning */
    .glance-grid {
        grid-template-columns: 1fr 1fr;
        gap: 0.55rem;
    }
    .glance-card {
        padding: 0.65rem 0.7rem;
        gap: 9px;
        border-radius: 12px;
    }
    .glance-card .ic {
        width: 36px;
        height: 36px;
        font-size: 0.95rem;
        border-radius: 10px;
    }
    .glance-card .val {
        font-size: 1rem;
    }
    .glance-card .val small {
        font-size: 0.72rem;
    }
    .glance-card .lbl {
        font-size: 0.72rem;
        margin-top: 1px;
    }
}
</style>
